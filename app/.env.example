# ===== 应用 / 鉴权 =====
AUTH_SECRET=change-me-to-a-random-string-at-least-16-chars
APP_URL=http://localhost:3000

# ===== 数据库（V2 固定 SQLite）=====
DATABASE_URL=file:.data/db/dev.db

# ===== 存储（V2 固定本地）=====
STORAGE_LOCAL_PATH=.data/storage

# ===== 生图 Provider =====
# mock = 内置占位图；newapi = CCLOAD New API
GENERATION_PROVIDER=mock

# New API 单渠道（mock 模式可留空）
CCLOAD_NEW_API_BASE_URL=
CCLOAD_NEW_API_TOKEN=
CCLOAD_IMAGE_MODEL=gpt-image-2
CCLOAD_IMAGE_ENDPOINT_MODE=images

# New API 多渠道（优先级高于单渠道，留空则用单渠道）
CCLOAD_CHANNELS=

# ===== 聊天渠道（OPT-5）=====
# 聊天渠道不走环境变量，在设置页按用户配置（可勾"沿用图像渠道"）。
# 都没配时兜底复用上面的 CCLOAD_NEW_API_BASE_URL + CCLOAD_NEW_API_TOKEN。

# ===== 自动清理策略（OPT-2）=====
# 前两项是「兜底默认值」：管理员可在设置页覆盖（存 SystemSetting），
# 改完即时生效、无需重启容器。这里的值只在数据库无配置时使用（如全新部署）。
# 优先级：设置页 > 本文件。
#
# 生成资产与上传图共用这两个阈值，但各自独立计数。收藏图不豁免清理。
# 删除是物理删除（删文件 + 删记录 + 递归删微调子树），不可恢复。
ASSET_RETENTION_DAYS=30
MAX_ASSETS_PER_USER=300

# 以下三项只能在此配置，设置页不暴露。
# 聊天保留期独立于资产（OPT-5 决策：30 天 + 滑动窗口 40 条，不做数量上限）
CHAT_RETENTION_DAYS=30
# failed / canceled 的 Job 保留多久
FAILED_JOB_RETENTION_DAYS=7
# 清理 tick 间隔。worker 启动 2 分钟后跑第一次，之后按此间隔周期执行
CLEANUP_INTERVAL_HOURS=6
