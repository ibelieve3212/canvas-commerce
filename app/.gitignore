# 依赖
node_modules/
**/node_modules/
/.pnp
.pnp.*

# Next 构建产物
.next/
**/.next/
/out/
# next-env.d.ts 由 next 自动生成，不入库。
# 它的内容会随上一次构建模式变（dev 时引 ./.next/dev/types/…，
# 生产构建时引 ./.next/types/…），入库会造成无意义的反复 diff。
# 官方文档建议入库，但已实测：删掉它 + 删掉 .next 后跑 tsc --noEmit 仍为 0
# （本项目 tsconfig 开了 skipLibCheck），所以 CI 不需要它。
next-env.d.ts
**/next-env.d.ts

# 构建
/build/
/dist/
**/dist/

# TypeScript 缓存
*.tsbuildinfo

# 数据库与本地存储（含用户数据，绝不入库）
.data/
**/.data/
/prisma/migrations/dev.db*

# 测试产物
/test-results/
**/test-results/
/playwright-report/
/blob-report/
/coverage/

# 环境变量 / 密钥（保留 .env.example）
.env
.env.local
.env*.local
.env.test-provider

# 系统/编辑器
.DS_Store
Thumbs.db
*.pem
*.log
npm-debug.log*
pnpm-debug.log*
.idea
.vscode/

# Windows 误产物
nul
NUL
npx
