# Docker 部署用环境变量。复制成 .env 后填写：
#   cp .env.docker.example .env
#
# 注意这是**部署用**的 .env（docker compose 读它），
# 与 app/.env（本地开发用）是两个不同的文件。

# ---- 必填 ----
# 会话 cookie 签名密钥，至少 16 字符。生成一个：
#   openssl rand -base64 32
AUTH_SECRET=

# ---- 镜像（必填）----
# 镜像由 GitHub Actions 构建后推到 GHCR，部署机只拉不构建。
# 指定版本而不用 :latest 会更可控，例如 :v1.0.0 或 :sha-abc1234。
# fork 到别的账号时把 ibelieve3212 换成你的用户名/组织名（GHCR 要求全小写）。
IMAGE=ghcr.io/ibelieve3212/canvas-commerce:latest

# ---- 访问地址 ----
# 宿主机监听端口（默认只绑 127.0.0.1，见 docker-compose.yml）
HOST_PORT=3000
# 对外访问地址，反向代理后填公网域名
APP_URL=http://localhost:3000

# ---- 首次启动创建的管理员（仅在库里没有任何管理员时生效）----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- 图片生成 Provider ----
# mock  = 生成占位图，用来验证部署链路是否通
# newapi = 调 OpenAI 兼容接口
GENERATION_PROVIDER=mock
CCLOAD_NEW_API_BASE_URL=
CCLOAD_NEW_API_TOKEN=
CCLOAD_IMAGE_MODEL=gpt-image-2

# ---- 自动清理兜底值（管理员设置页的配置优先级更高）----
ASSET_RETENTION_DAYS=30
MAX_ASSETS_PER_USER=300
CHAT_RETENTION_DAYS=30
FAILED_JOB_RETENTION_DAYS=7
CLEANUP_INTERVAL_HOURS=6

# ---- 资源限制 ----
# 2GB 内存的机器建议留 1500m；内存更大可调高
MEM_LIMIT=1500m
